{
  "manifest_version": 3,
  "name": "Azhura Download Manager Capture",
  "version": "0.1.0",
  "description": "Send links to Azhura Download Manager via right-click.",
  "browser_specific_settings": {
    "gecko": {
      "id": "adm-capture@ruhiyatna.id",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_icon": {
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Click, then click the page's download button — the next browser download is redirected to ADM"
  },
  "permissions": ["contextMenus", "notifications", "downloads", "storage", "cookies"],
  "host_permissions": ["*://*.gofile.io/*"]
}
