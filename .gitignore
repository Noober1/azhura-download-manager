# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets & signing keys — never commit.
# extension.pem signs the browser extension and fixes its extension ID;
# leaking it lets anyone publish an update that impersonates this extension.
*.pem
*.key
*.pfx
*.p12
*.p8
*.jks
*.keystore
*.der
*.cer
*.crt
*.ppk
*.asc
*.gpg
id_rsa*
id_ed25519*
*.mobileprovision

# Environment files (an .env.example placeholder is fine to track)
.env
.env.*
!.env.example

# Signed extension bundle — build output produced from extension.pem
*.crx
